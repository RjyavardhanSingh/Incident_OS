# Simulator environment configuration. Copy to .env and adjust as needed.

# Where Incident OS OTLP telemetry is ingested.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8000/api/v1/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Service name used by the simulator (must be unique per process).
SIM_SERVICE_NAME=gateway

# Port this service listens on.
SIM_SERVICE_PORT=8010

# Postgres used by the demo production system (schema `demo` inside the shared dev server).
SIM_DATABASE_URL=postgresql+psycopg://incident_os:incident_os_dev@localhost:5433/incident_os_dev

# Redis used by the demo production system.
SIM_REDIS_URL=redis://localhost:6379/0

# Kafka bootstrap used by the demo production system.
SIM_KAFKA_BOOTSTRAP=localhost:9092

# Downstream service base URLs.
SIM_AUTH_URL=http://localhost:8011
SIM_ORDERS_URL=http://localhost:8012
SIM_PAYMENTS_URL=http://localhost:8013
SIM_INVENTORY_URL=http://localhost:8014
SIM_NOTIFICATIONS_URL=http://localhost:8015
